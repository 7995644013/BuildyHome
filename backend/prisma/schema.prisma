generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  project_manager
  site_engineer
  client
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  PENDING_APPROVAL
  DONE
  ARBITRATION
}

enum ExpenseType {
  TASK_RELATED
  MATERIAL
  GENERAL
}

enum ApprovalType {
  TICKET_CLOSE
  BUDGET_APPROVAL
  PROJECT_DELETE
  EXPENSE_APPROVAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
  PENDING_CLOSE_APPROVAL
}

enum BudgetStatus {
  DRAFT
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String?   @unique
  name              String?
  hashedPassword    String
  role              UserRole
  designation       String?
  phone             String?
  isActive          Boolean   @default(true)
  passwordChangedAt DateTime? // null = must change password on first login
  
  // OTP-based features
  resetOtp          String?   // OTP for password reset
  resetOtpExpiresAt DateTime? // Expiration timestamp for reset OTP
  isEmailVerified   Boolean   @default(false) // Email verification status
  verifyOtp         String?   // OTP for email verification
  verifyOtpExpiresAt DateTime? // Expiration for verification OTP
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdById       String?

  // Project assignments (many-to-many)
  projectAssignments ProjectAssignment[]

  // Legacy relations (keeping for backward compatibility)
  projects       Project[]     @relation("ProjectManager")
  clientProjects Project[]     @relation("ProjectClient")
  tasks          Task[]        @relation("TaskAssignee")
  createdTasks   Task[]        @relation("TaskCreatedBy")
  teams          TeamMember[]
  expenses       Expense[]
  reports        DailyReport[]
  taskComments   TaskComment[]
  arbitrations   Arbitration[]
  createdUsers   User[]        @relation("UserCreatedBy")

  // Approvals & Tickets
  requestedApprovals Approval[] @relation("ApprovalRequestedBy")
  approvedApprovals  Approval[] @relation("ApprovalApprovedBy")
  createdTickets     Ticket[]   @relation("TicketCreatedBy")
  assignedTickets    Ticket[]   @relation("TicketAssignedTo")
  ticketComments     TicketComment[]
}

model Project {
  id              String        @id @default(uuid())
  referenceNumber String        @unique
  name            String
  description     String?
  status          ProjectStatus @default(PLANNING)
  priority        String?       @default("MEDIUM")
  progress        Int           @default(0)
  startDate       DateTime?
  endDate         DateTime?
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  projectManager   User    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  projectManagerId String
  client           User?   @relation("ProjectClient", fields: [clientId], references: [id])
  clientId         String?

  // Many-to-many user assignments
  assignments ProjectAssignment[]

  tasks     Task[]
  budget    Budget?
  expenses  Expense[]
  materials Material[]
  landInfo  LandInfo?
  reports   DailyReport[]
  teamLinks ProjectTeam[]
  tickets   Ticket[]
}

model Task {
  id               String     @id @default(uuid())
  project          Project    @relation(fields: [projectId], references: [id])
  projectId        String
  assignee         User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId       String?
  createdBy        User?      @relation("TaskCreatedBy", fields: [createdById], references: [id])
  createdById      String?
  title            String
  description      String?
  status           TaskStatus @default(TODO)
  userApproved     Boolean    @default(false)
  adminApproved    Boolean    @default(false)
  clientApproved   Boolean    @default(false)
  disputeStartedAt DateTime?
  inArbitration    Boolean    @default(false)
  dueDate          DateTime?
  completedAt      DateTime?
  isDeleted        Boolean    @default(false)
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  expenses    Expense[]
  photos      TaskPhoto[]
  comments    TaskComment[]
  arbitration Arbitration?

  @@index([projectId])
  @@index([assigneeId])
  @@index([createdById])
}

model Budget {
  id              String   @id @default(uuid())
  project         Project  @relation(fields: [projectId], references: [id])
  projectId       String   @unique
  totalAmount     Decimal  @default(0) @db.Decimal(15, 2)
  remainingAmount Decimal  @default(0) @db.Decimal(15, 2)
  currency        String       @default("USD")
  status          BudgetStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt  
  items           BudgetItem[]

}

model BudgetItem {
  id          String   @id @default(uuid())
  budget      Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  budgetId    String
  category    String   // e.g., "Materials", "Labor", "Permits"
  description String
  amount      Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}




enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id          String      @id @default(uuid())
  project     Project     @relation(fields: [projectId], references: [id])
  projectId   String
  task        Task?       @relation(fields: [taskId], references: [id])
  taskId      String?
  material    Material?   @relation(fields: [materialId], references: [id])
  materialId  String?
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdById String
  amount      Decimal     @db.Decimal(15, 2)
  category    String
  description String?
  expenseType ExpenseType
  status      ExpenseStatus @default(PENDING)
  expenseDate DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([taskId])
  @@index([materialId])
  @@index([status])
}

model Material {
  id                String   @id @default(uuid())
  name              String
  unit              String
  unitPrice         Decimal  @db.Decimal(10, 2)
  quantityAvailable Int      @default(0)
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expenses  Expense[]
  project   Project?  @relation(fields: [projectId], references: [id])
  projectId String?
}

model LandInfo {
  id               String   @id @default(uuid())
  project          Project  @relation(fields: [projectId], references: [id])
  projectId        String   @unique
  address          String
  areaSqft         Decimal? @db.Decimal(12, 2)
  ownershipType    String?
  legalDescription String?
  coordinates      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DailyReport {
  id          String   @id @default(uuid())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  reportDate  DateTime
  workDone    String
  issues      String?
  nextSteps   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, createdById, reportDate])
}

model Team {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  TeamMember[]
  projects ProjectTeam[]
}

model TeamMember {
  team     Team     @relation(fields: [teamId], references: [id])
  teamId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@id([teamId, userId])
}

model ProjectTeam {
  project   Project @relation(fields: [projectId], references: [id])
  projectId String
  team      Team    @relation(fields: [teamId], references: [id])
  teamId    String

  @@id([projectId, teamId])
}

model TaskPhoto {
  id         String   @id @default(uuid())
  task       Task     @relation(fields: [taskId], references: [id])
  taskId     String
  photoUrl   String
  caption    String?
  uploadedAt DateTime @default(now())
}

model TaskComment {
  id        String   @id @default(uuid())
  task      Task     @relation(fields: [taskId], references: [id])
  taskId    String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Arbitration {
  id           String    @id @default(uuid())
  task         Task      @relation(fields: [taskId], references: [id])
  taskId       String    @unique
  resolvedBy   User?     @relation(fields: [resolvedById], references: [id])
  resolvedById String?
  resolution   String?
  notes        String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
}

// Many-to-Many: User-Project Assignments
// Tracks which users have access to which projects
model ProjectAssignment {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  role       String? // Optional: role within this project (e.g., "lead_engineer", "viewer")
  assignedAt DateTime @default(now())
  assignedBy String? // User ID who made the assignment

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model Approval {
  id          String         @id @default(uuid())
  type        ApprovalType
  targetId    String         // ID of the Ticket, Budget, or Project
  status      ApprovalStatus @default(PENDING)
  
  requestedBy   User     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  requestedById String
  
  approvedBy    User?    @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  approvedById  String?

  comments    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetId])
  @@index([status])
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Ticket {
  id          String       @id @default(uuid())
  project     Project      @relation(fields: [projectId], references: [id])
  projectId   String
  title       String
  description String
  status      TicketStatus @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  
  createdBy   User     @relation("TicketCreatedBy", fields: [createdById], references: [id])
  createdById String

  assignedTo   User?    @relation("TicketAssignedTo", fields: [assignedToId], references: [id])
  assignedToId String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments     TicketComment[]

  @@index([projectId])
  @@index([status])
}

model TicketComment {
  id        String   @id @default(uuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([ticketId])
}
